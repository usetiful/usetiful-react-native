{
  "name": "@fullstory/guides-and-surveys-react-native",
  "version": "0.1.0-beta.0",
  "description": "Guides and surveys react native support",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    }
  },
  "files": [
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace guides-and-surveys-react-native-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it",
    "localpack": "yarn prepare && npm pack"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullstorydev/guides-and-surveys-react-native.git"
  },
  "author": "Fullstory",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fullstorydev/guides-and-surveys-react-native/issues"
  },
  "homepage": "https://github.com/fullstorydev/guides-and-surveys-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "react-hook-form": "^7.71.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@fullstory/react-native": "^1.8.2",
    "@react-native-async-storage/async-storage": "*",
    "@react-native/eslint-config": "^0.73.1",
    "@react-navigation/native": "^6.0.0",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/jest": "^29.5.5",
    "@types/react": "^18.2.44",
    "commitlint": "^17.0.2",
    "del-cli": "^5.1.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "react": "18.2.0",
    "react-native": "0.79.2",
    "react-native-builder-bob": "^0.29.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-webview": "^13.0.0",
    "react-native-worklets": "^0.7.4",
    "reactotron-react-native": "^5.1.18",
    "release-it": "^18.1.2",
    "typescript": "^5.2.2",
    "zustand": "^4.5.5"
  },
  "resolutions": {
    "@types/react": "^18.2.44",
    "function-bind": "npm:@socketregistry/function-bind@1.0.6",
    "ip": "^2.0.2"
  },
  "peerDependencies": {
    "@fullstory/react-native": "*",
    "@react-native-async-storage/async-storage": "*",
    "@react-navigation/native": "^6.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.16.1",
    "react-native-reanimated": ">=2.0.0",
    "react-native-webview": "^13.0.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "prettier/prettier": "error"
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  },
  "create-react-native-library": {
    "type": "library",
    "version": "0.40.0"
  }
}
